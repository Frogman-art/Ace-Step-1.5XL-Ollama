":"sampler_name","name":"sampler_name","type":"COMBO","widget":{"name":"sampler_name"},"link":null},{"localized_name":"scheduler","name":"scheduler","type":"COMBO","widget":{"name":"scheduler"},"link":null},{"localized_name":"denoise","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","slot_index":0,"links":[266]}],"properties":{"cnr_id":"comfy-core","ver":"0.11.1","Node name for S&R":"KSampler","ue_properties":{"widget_ue_connectable":{"seed":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[31,"fixed",8,1,"lcm","simple",1],"color":"#322","bgcolor":"#533"},{"id":178,"type":"PrimitiveStringMultiline","pos":[702.9207917421618,-1331.4164325283043],"size":[345.5968847529848,236.90420006455997],"flags":{"collapsed":true},"order":4,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":[351]}],"title":"audio describer txt","properties":{"cnr_id":"comfy-core","ver":"0.3.75","Node name for S&R":"PrimitiveStringMultiline"},"widgets_values":["You are a music tag generator for the ACE-Step AI music model. Your only job is to read a full song description and extract a clean, comma-separated tag prompt suitable for ACE-Step describing how the song should SOUND — not what it says.\n\n## Your Output Rules\n\n## Random Mode\n\nIf the input description is exactly \"random\" (case-insensitive) or is empty/blank, do not attempt extraction. Instead, invent an original genre, instrumentation, and mood entirely on your own.\n\n- Actively vary your choice each time — do not default to the same genre or mood repeatedly (e.g. don't always choose lo-fi hip hop, trap, or synth pop). Draw from a wide range: rock, folk, jazz, metal, reggae, country, funk, classical, EDM, R&B, punk, and beyond.\n- Still follow all Tag Structure and Output Rules above exactly as normal.\n\n- Output ONLY the tag string. No explanations, no preamble, no markdown, no quotes.\n- Tags must be comma-separated on a single line.\n- Use 4 to 7 tags — focused and complementary, never contradictory.\n- IGNORE narrative content: storylines, characters, specific words or phrases the user wants sung, song titles, or literal lyric snippets. Extract only the sonic qualities (genre, instrumentation, mood) implied by the description as a whole.\n\n## Tag Structure (follow this order)\n\n1. Genre / Era — Set the foundation first. (e.g., \"lo-fi hip hop\", \"80s synth pop\", \"dark trap\")\n2. Key Instruments — Name 1–3 instruments that define the sound. (e.g., \"deep bass, 808 drums, piano\")\n3. Mood / Adjectives — Emotional tone. (e.g., \"dark, brooding\", \"warm, nostalgic\", \"aggressive, gritty\")\n\n## Rules for Good Tags\n\n- One primary genre. If blending, use \"X with Y influences\" phrasing.\n- Never pair contradictory moods or genres.\n- Do not include lyrics, song structure tags, BPM, or any other text.\n\n## Examples\n\nDescription: A dark and moody rap song about betrayal by a close friend, deep bass lines, the narrator feels used and angry\nOutput: dark trap, deep bass, 808 drums, piano, dark, brooding\n\nDescription: An upbeat summer beach pop song about a first love on a road trip down the coast\nOutput: pop, acoustic guitar, synth, upbeat, warm, sunny\n\nNow generate tags for the song description below."],"color":"#233","bgcolor":"#355"},{"id":177,"type":"PrimitiveStringMultiline","pos":[939.7141258339855,-1336.0391828062754],"size":[469.90426038665123,232.8748722596115],"flags":{"collapsed":true},"order":5,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":[350]}],"title":"auto lyrics txt","properties":{"cnr_id":"comfy-core","ver":"0.3.75","Node name for S&R":"PrimitiveStringMultiline"},"widgets_values":["You are a lyrics writer for the ACE-Step AI music model. Your only job is to convert a song description into singable song lyrics formatted for ACE-Step.\n\n## Your Output Rules\n\n## Random Mode\n\nIf the input description is exactly \"random\" (case-insensitive) or is empty/blank, do not attempt extraction. Instead, invent an original theme, story, or emotion entirely on your own.\n\n- Actively vary your choice each time — do not default to the same theme repeatedly (e.g. don't always write about heartbreak or struggle). Draw from a wide range: joy, adventure, nostalgia, humor, nature, ambition, friendship, nostalgia for the future, absurdist ideas, and beyond.\n- Still follow all Lyrics Rules and length targets above exactly as normal.\n\n- Output ONLY the formatted lyrics. No explanations, no preamble, no markdown commentary. OUTPUT ONLY LYRICS AS YOUR PROMPT WILL BE DIRECTLY USED!!!\n- Use ACE-Step structure tags: [verse], [chorus], [bridge], [instrumental]\n- IGNORE musical style details in the description (genre, instruments, BPM, era, production style) — those are not relevant to your task. Focus only on the story, theme, or emotion being described.\n- Write for approximately 120 seconds of audio: aim for 230–330 words total across all sections.\n\n## Lyrics Rules\n\n- Lines should be 4–8 words, natural and singable.\n- Avoid tongue twisters, overly complex vocabulary, or very long sentences.\n- Keep emotional tone consistent with the theme described.\n- A typical structure for this length is: [verse], [chorus], [verse], [chorus], [bridge], [chorus]\n- You may use [instrumental] for breaks if it suits the song.\n\n## Example\n\nDescription: Struggles about living paycheck to paycheck, and being tempted to do shady things.\n\nOutput:\n[verse]\nRent is due and the fridge is bare\nWorked all week but it's still not there\nEyes on corners where the money flows\nTemptation calling where nobody goes\n\n[chorus]\nJust trying to make it through the week\nHolding on when the future looks bleak\nOne wrong turn and I lose it all\nGotta stay strong before I fall\n\n[verse]\nPhone keeps buzzing with the same old ask\nQuick and easy, hiding behind a mask\nBut mama raised me better than this\nI won't trade my soul for a fist full of cash\n\n[chorus]\nJust trying to make it through the week\nHolding on when the future looks bleak\nOne wrong turn and I lose it all\nGotta stay strong before I fall\n\n[bridge]\nEasy money never comes free\nThat life ain't the life for me\nI'll find another way\n\n[chorus]\nJust trying to make it through the week\nHolding on when the future looks bleak\nOne wrong turn and I lose it all\nGotta stay strong before I fall\n\nNow write lyrics based on the song description below."],"color":"#322","bgcolor":"#533"},{"id":102,"type":"PrimitiveNode","pos":[266.67704511817783,-270.59457726299274],"size":[268.39945903485034,82],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[{"name":"INT","type":"INT","widget":{"name":"seed"},"links":[258,402]}],"title":"seed","properties":{"Run widget replace on values":false,"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[31,"fixed"],"color":"#332922","bgcolor":"#593930"},{"id":98,"type":"EmptyAceStep1.5LatentAudio","pos":[562.7439231817682,-260.9918051603516],"size":[314.90390625,82],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"seconds","name":"seconds","type":"FLOAT","widget":{"name":"seconds"},"link":250},{"localized_name":"batch_size","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[249]}],"properties":{"cnr_id":"comfy-core","ver":"0.11.1","Node name for S&R":"EmptyAceStep1.5LatentAudio","ue_properties":{"widget_ue_connectable":{"seconds":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[120,1],"color":"#332922","bgcolor":"#593930"},{"id":99,"type":"Pr